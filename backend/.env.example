APP_NAME="AI Diet Coach"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_diet_coach
DB_USERNAME=adc
DB_PASSWORD=adc_dev_password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Dev mail: logs instead of sending — PENDING CONFIGURATION for real SMTP/provider
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@aidietcoach.example"
MAIL_FROM_NAME="${APP_NAME}"

# ── External services: PENDING CONFIGURATION ──
# AI provider (used only server-side by the AI gateway; never shipped to clients)
AI_PROVIDER=fake            # fake | anthropic | openai | ...
AI_API_KEY=
# Push notifications
FCM_CREDENTIALS_PATH=
APNS_KEY_PATH=
# Social sign-in
GOOGLE_OAUTH_CLIENT_ID=
APPLE_SIGNIN_KEY_ID=
